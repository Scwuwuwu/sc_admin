 <!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.sc.mapper.DeptMapper">
    <select id="selectById" resultType="com.sc.pojo.Dept">
        select * from dept where dept_id = #{deptId}
    </select>
</mapper>