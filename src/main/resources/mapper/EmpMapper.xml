<?xml version="1.0" encoding="UTF-8" ?>
 <!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.sc.mapper.EmpMapper">
    <select id="queryAll" resultType="com.sc.pojo.Emp">
        select * from emp
    </select>

    <select id="queryCondition" resultType="com.sc.pojo.Emp">
        select * from emp where 1=1
        <if test="emp_name != null">
            and emp_name like concat('%',#{emp_name},'%')
        </if>
        <if test="emp_sex != null">
            and emp_sex = #{emp_sex}
        </if>
    </select>

    <delete id="deleteById">
        delete from emp where emp_id = #{id}
    </delete>
</mapper>